# Upstream OpenAI-compatible chat completions endpoint.
# The proxy calls: ${OPENAI_API_ENDPOINT}${OPENAI_CHAT_COMPLETIONS_PATH}
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.5

# Optional: require Claude Code to send this via ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY.
PROXY_AUTH_TOKEN=change-me

# Optional: map Claude model names requested by Claude Code to your OpenAI model.
MODEL_MAPPING_JSON={"claude-sonnet-4-5":"gpt-5.5","claude-opus-4-5":"gpt-5.5"}
# Alternative format: MODEL_MAP=claude-sonnet-4-5=gpt-5.5,claude-opus-4-5=gpt-5.5

# Optional: set the models shown by /v1/models.
PUBLIC_MODELS=claude-sonnet-4-5,claude-opus-4-5

# Optional upstream/proxy tuning.
REQUEST_TIMEOUT_SECONDS=600
OPENAI_MAX_TOKENS_FIELD=auto
OPENAI_STREAM_INCLUDE_USAGE=false
LOG_LEVEL=INFO

# Optional for non-standard OpenAI-compatible gateways.
# OPENAI_API_KEY_HEADER=Authorization
# OPENAI_API_KEY_PREFIX=Bearer
# OPENAI_EXTRA_HEADERS_JSON={"X-Custom":"value"}
# OPENAI_EXTRA_BODY_JSON={"reasoning_effort":"medium"}
# REQUIRE_OPENAI_API_KEY=true
